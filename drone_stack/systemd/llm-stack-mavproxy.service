# MAVProxy hub: the ONLY owner of the flight-controller link; fans out UDP
# 14550 (QGC) / 14560 (MCP server) / 14565 (monitor). Installed by install.sh,
# which replaces @ROOT@ (repo path) and @LINK@ (pixhawk | radio | sitl).
[Unit]
Description=LLM stack - MAVProxy MAVLink hub (@LINK@)
After=network.target

[Service]
Type=simple
WorkingDirectory=@ROOT@
Environment=PATH=@ROOT@/drone_stack/.venv/bin:/usr/local/bin:/usr/bin:/bin
Environment=INTERACTIVE=0
ExecStart=@ROOT@/drone_stack/mavproxy/start_mavproxy.sh @LINK@
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
